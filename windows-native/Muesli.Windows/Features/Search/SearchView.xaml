<features:FeatureViewBase x:Class="Muesli.Windows.Features.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:Muesli.Windows.Features">
  <Grid x:Name="SearchPage">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
          <TextBlock Text="{Binding SearchResultsTitle}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding SearchResultsSummary}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <Border Margin="0,14,0,0"
                  Padding="10,0"
                  Height="36"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="6">
            <TextBox x:Name="MainSearchInput"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource AccentBlueBrush}"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     ToolTip="Search dictations and meetings"
                     AutomationProperties.Name="Search dictations and meetings" />
          </Border>
        </StackPanel>

         <Grid Grid.Row="1">
           <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="0,0,12,0"
                         Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
             <StackPanel MaxWidth="980" Margin="0,0,0,24">
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="DICTATIONS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="{DynamicResource BackgroundRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,0,24">
              <ListBox ItemsSource="{Binding SearchDictationResults}"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource MuesliListBoxItem}"
                       MouseDoubleClick="ForwardMouseButton" features:FeatureAction.Name="DictationsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="20,14"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="ForwardMouseButton" features:FeatureAction.Name="DictationRow_Click">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Background="Transparent"
                               BorderThickness="0"
                               IsReadOnly="True"
                               Cursor="IBeam"
                               Padding="0"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Disabled"
                               SelectionBrush="{DynamicResource AccentBlueBrush}" />
                      <Button Grid.Column="2"
                              Margin="14,-4,0,0"
                              Style="{StaticResource GhostButton}"
                              Content="&#xE8C8;"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              ToolTip="Copy"
                              Click="ForwardClick" features:FeatureAction.Name="CopyDictation_Click" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="MEETINGS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding SearchMeetingResults}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ItemContainerStyle="{StaticResource MuesliListBoxItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource BackgroundRaisedBrush}"
                          BorderBrush="{DynamicResource BorderBrushSoft}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="16"
                          Margin="0,0,0,10"
                          Cursor="Hand"
                          MouseLeftButtonUp="ForwardMouseButton" features:FeatureAction.Name="MeetingCard_Click">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Metadata}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PreviewText}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   MaxHeight="38"
                                   LineHeight="19" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="&#xE8B7;"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 FontSize="14"
                                 Foreground="{DynamicResource AccentBlueBrush}"
                                 Margin="0,2,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
             </ListBox>
           </StackPanel>
         </ScrollViewer>
         <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasSearchResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
           <TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIcon}" />
           <TextBlock Text="No results found" Style="{StaticResource EmptyStateTitle}" />
           <TextBlock Text="Try a different search term." Style="{StaticResource EmptyStateBody}" />
          </StackPanel>
        </Grid>
      </Grid>
</features:FeatureViewBase>
