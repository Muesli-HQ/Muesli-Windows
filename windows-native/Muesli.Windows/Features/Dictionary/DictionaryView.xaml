<features:FeatureViewBase x:Class="Muesli.Windows.Features.Dictionary.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:Muesli.Windows.Features">
  <Grid x:Name="DictionaryPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="860" Margin="0,0,0,24">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="ForwardClick" features:FeatureAction.Name="AddDictionaryEntry_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="+" FontWeight="Bold" Margin="0,0,6,0" />
                <TextBlock Text="Add new" />
              </StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="Dictionary" Style="{StaticResource PageTitle}" />
              <TextBlock Text="Add custom words for names, brands, and domain terms, and tune how aggressively each entry should fuzzy-match transcription errors." Style="{StaticResource PageSubtitle}" />
              <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Border Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="0">
            <StackPanel>
              <Grid Margin="16,16,16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DictionaryPhraseBox" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" FontSize="14" />
                <TextBox x:Name="DictionaryReplacementBox" Grid.Column="1" Margin="12,0,0,0" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" FontSize="14" />
              </Grid>
              <Grid Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Matching threshold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Slider x:Name="DictionaryThresholdSlider"
                        Grid.Column="1"
                        Minimum="0.85"
                        Maximum="0.98"
                        SmallChange="0.01"
                        LargeChange="0.05"
                        Value="0.90" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ElementName=DictionaryThresholdSlider, Path=Value, StringFormat={}{0:0.00}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" />
              <ListBox ItemsSource="{Binding DictionaryEntries}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" ItemContainerStyle="{StaticResource MuesliListBoxItem}" Visibility="{Binding HasDictionaryEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="16,16">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" />
                        <TextBox Grid.Column="1" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" />
                      </Grid>
                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="48" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Matching threshold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.70" Maximum="0.95" SmallChange="0.01" LargeChange="0.05" Value="{Binding MatchingThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{Binding ThresholdDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Content="Delete" Foreground="{DynamicResource ErrorRedBrush}" Click="ForwardClick" features:FeatureAction.Name="DeleteDictionaryEntry_Click" />
                        <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Content="Save" Click="ForwardClick" features:FeatureAction.Name="SaveDictionaryEntry_Click" />
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Margin="0,32" Visibility="{Binding HasDictionaryEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="&#xE70F;" Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Text="No custom dictionary entries yet" Style="{StaticResource EmptyStateTitle}" />
                <TextBlock Text="Add a word or phrase above to improve transcription accuracy." Style="{StaticResource EmptyStateBody}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
</features:FeatureViewBase>
