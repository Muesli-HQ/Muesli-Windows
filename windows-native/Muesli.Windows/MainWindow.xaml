<Window x:Class="Muesli.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Muesli"
        Icon="Assets/muesli_app_icon.png"
        Width="1240"
        Height="820"
        MinWidth="760"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="8"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{DynamicResource BackgroundDeepBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="72" MaxWidth="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="2" Height="36" VerticalAlignment="Top" Background="Transparent" Panel.ZIndex="10">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,3,8,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource ChromeButton}" Content="-" Click="Minimize_Click" AutomationProperties.Name="Minimize Muesli window" />
        <Button Style="{StaticResource ChromeButton}" Content="□" Click="MaximizeRestore_Click" AutomationProperties.Name="Maximize or restore Muesli window" />
        <Button Style="{StaticResource ChromeButton}" Content="x" Click="Close_Click" AutomationProperties.Name="Close Muesli window" />
      </StackPanel>
    </Grid>

    <Border Grid.Column="0"
            Margin="0,44,0,0"
            Background="{DynamicResource BackgroundDeepBrush}"
            BorderBrush="{DynamicResource BorderBrushMedium}"
            BorderThickness="0,1,1,1"
            CornerRadius="0,14,14,0">
      <Border.Resources>
        <Style x:Key="CompactAwareSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Padding" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="CompactAwareSidebarChildButton" TargetType="Button" BasedOn="{StaticResource SidebarChildButton}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Padding" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="CompactSidebarLabel" TargetType="TextBlock">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="CompactHeaderText" TargetType="TextBlock">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="CompactHeaderBrand" TargetType="StackPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="HorizontalAlignment" Value="Center" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="CompactHeaderSearchSurface" TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="CompactOnlySearchButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="Margin" Value="0,10,0,0" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="NormalOnlyRailAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="CompactOnlyCreateFolder" TargetType="Button" BasedOn="{StaticResource GhostButton}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Setter Property="Width" Value="28" />
          <Setter Property="Height" Value="28" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="Margin" Value="0,2" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="CompactThemeSwitch" TargetType="Border">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Margin" Value="24,12,0,0" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter Property="HorizontalAlignment" Value="Center" />
              <Setter Property="Margin" Value="0,12,0,0" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Resources>
      <Grid Margin="0,24,0,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,0,16,20">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Style="{StaticResource CompactHeaderBrand}">
            <Border Width="22" Height="22" Background="{DynamicResource AccentBlueBrush}">
              <Border.OpacityMask>
                <ImageBrush ImageSource="Assets/menu_m_template@2x.png" Stretch="Uniform" />
              </Border.OpacityMask>
            </Border>
            <TextBlock Text="muesli" Margin="12,0,0,0" FontSize="22" FontWeight="SemiBold" Style="{StaticResource CompactHeaderText}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
          <TextBlock Text="{Binding UserGreeting}" Margin="34,4,0,0" FontSize="12" Style="{StaticResource CompactHeaderText}"
                     Foreground="{DynamicResource TextTertiaryBrush}" />
          <Border Margin="-8,18,-8,0" Style="{StaticResource CompactHeaderSearchSurface}"
                  Height="32"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="10,0">
            <DockPanel>
              <TextBlock Text="&#xE721;"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <Grid>
                <TextBlock Text="Search..."
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource AccentBlueBrush}"
                         Margin="0,0,22,0"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         ToolTip="Search dictations and meetings" AutomationProperties.Name="Search dictations and meetings" />
                <Button HorizontalAlignment="Right"
                        Width="18"
                        Height="18"
                        Padding="0"
                        Content="x"
                        Foreground="{DynamicResource TextTertiaryBrush}"
                        Click="ClearSearch_Click" AutomationProperties.Name="Clear search">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </Grid>
            </DockPanel>
          </Border>
          <Button Style="{StaticResource CompactOnlySearchButton}"
                  Content="&#xE721;"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                  ToolTip="Search dictations and meetings"
                  Click="OpenSearchFromCompactRail_Click"
                  AutomationProperties.Name="Open search and focus the search field" />
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="DictationsNav" Style="{StaticResource CompactAwareSidebarButton}" Background="{DynamicResource SurfaceSelectedBrush}" Click="ShowDictations_Click" ToolTip="Dictations" AutomationProperties.Name="Navigate to Dictations">
            <DockPanel LastChildFill="True">
              <TextBlock Text="&#xE720;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBlueBrush}" />
              <TextBlock Text="Dictations" Style="{StaticResource CompactSidebarLabel}" />
            </DockPanel>
          </Button>
          <Grid Margin="8,2">
            <Button x:Name="MeetingsNav" Style="{StaticResource CompactAwareSidebarButton}" Margin="0" Click="ToggleMeetings_Click" ToolTip="Meetings" AutomationProperties.Name="Navigate to Meetings">
              <DockPanel LastChildFill="False">
                <TextBlock Text="&#xE716;" Style="{StaticResource NavIcon}" />
                <TextBlock Text="Meetings" Width="146" Style="{StaticResource CompactSidebarLabel}" />
                <TextBlock Text="{Binding MeetingsChevron}" Width="24" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource CompactSidebarLabel}" />
              </DockPanel>
            </Button>
            <Button Width="28"
                    Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Style="{StaticResource NormalOnlyRailAction}"
                    Padding="0"
                    Content="&#xE8F4;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    Foreground="{DynamicResource TextTertiaryBrush}"
                    ToolTip="New Meeting Folder"
                    Click="AddMeetingFolder_Click" AutomationProperties.Name="Create meeting folder" />
          </Grid>
          <Button Style="{StaticResource CompactOnlyCreateFolder}"
                  Content="&#xE8F4;"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                  Foreground="{DynamicResource TextTertiaryBrush}"
                  ToolTip="New Meeting Folder"
                  Click="AddMeetingFolder_Click"
                  AutomationProperties.Name="Create meeting folder" />
          <StackPanel x:Name="MeetingsChildren" Visibility="Visible">
            <Button x:Name="AllMeetingsNav" Style="{StaticResource CompactAwareSidebarChildButton}" Click="ShowMeetings_Click" ToolTip="All Meetings" AutomationProperties.Name="Navigate to All Meetings">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Grid.Column="1" Text="All Meetings" Style="{StaticResource CompactSidebarLabel}" />
                <TextBlock Grid.Column="2" Text="{Binding MeetingCount}" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource CompactSidebarLabel}" />
              </Grid>
            </Button>
            <ItemsControl ItemsSource="{Binding MeetingFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Button Style="{StaticResource CompactAwareSidebarChildButton}" Click="SelectMeetingFolder_Click" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name, StringFormat=Navigate to meeting folder {0}}">
                      <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                          <MenuItem Header="Rename" Click="RenameMeetingFolder_Click" />
                          <MenuItem Header="Move Up" Click="MoveMeetingFolderUp_Click" />
                          <MenuItem Header="Move Down" Click="MoveMeetingFolderDown_Click" />
                          <Separator />
                          <MenuItem Header="Delete" Click="DeleteMeetingFolder_Click" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CompactSidebarLabel}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                  <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource CompactSidebarLabel}" />
                      </Grid>
                    </Button>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="46,3,38,3"
                             Padding="6,2"
                             Background="{DynamicResource BackgroundHoverBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrushSoft}"
                             FontSize="13"
                             KeyDown="FolderNameBox_KeyDown"
                             LostFocus="FolderNameBox_LostFocus">
                      <TextBox.Style>
                        <Style TargetType="TextBox">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Button x:Name="DictionaryNav" Style="{StaticResource CompactAwareSidebarButton}" Click="ShowDictionary_Click" ToolTip="Dictionary" AutomationProperties.Name="Navigate to Dictionary">
            <DockPanel>
              <TextBlock Text="&#xE82D;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="Dictionary" Style="{StaticResource CompactSidebarLabel}" />
            </DockPanel>
          </Button>
          <Button x:Name="ModelsNav" Style="{StaticResource CompactAwareSidebarButton}" Click="ShowModels_Click" ToolTip="Models" AutomationProperties.Name="Navigate to Models">
            <DockPanel>
              <TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="Models" Style="{StaticResource CompactSidebarLabel}" />
            </DockPanel>
          </Button>
          <Button x:Name="ShortcutsNav" Style="{StaticResource CompactAwareSidebarButton}" Click="ShowShortcuts_Click" ToolTip="Shortcuts" AutomationProperties.Name="Navigate to Shortcuts">
            <DockPanel>
              <TextBlock Text="&#xE765;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="Shortcuts" Style="{StaticResource CompactSidebarLabel}" />
            </DockPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <Button x:Name="SettingsNav" Style="{StaticResource CompactAwareSidebarButton}" Click="ShowSettings_Click" ToolTip="Settings" AutomationProperties.Name="Navigate to Settings">
            <DockPanel>
              <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="Settings" Style="{StaticResource CompactSidebarLabel}" />
            </DockPanel>
          </Button>
          <Button x:Name="AboutNav" Style="{StaticResource CompactAwareSidebarButton}" Click="ShowAbout_Click" ToolTip="About" AutomationProperties.Name="Navigate to About">
            <DockPanel>
              <TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="About" Style="{StaticResource CompactSidebarLabel}" />
            </DockPanel>
          </Button>
          <Border Style="{StaticResource CompactThemeSwitch}"
                  Width="60"
                  Height="26"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  CornerRadius="6"
                  Padding="2">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="LightThemeButton"
                      Style="{StaticResource ThemeSegmentButton}"
                      Content="☀"
                      Click="SetLightTheme_Click" AutomationProperties.Name="Use light theme" />
              <Button x:Name="DarkThemeButton"
                      Style="{StaticResource ThemeSegmentButton}"
                      Content="☾"
                      Click="SetDarkTheme_Click" AutomationProperties.Name="Use dark theme" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Margin="0,44,0,0"
            Background="{DynamicResource BackgroundBaseBrush}" />

    <Grid Grid.Column="1" Margin="24,76,24,28">
      <Grid x:Name="DictationsPage">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,28">
          <Border Style="{StaticResource StatCard}">
            <StackPanel HorizontalAlignment="Center">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,2,0,8">
                <Path Fill="{DynamicResource WarningOrangeBrush}" Data="M10,1 C14,5 15,8 13,11 C15,10 16,8 16,6 C18,9 18,14 14,17 C11,20 6,19 4,15 C2,11 4,8 7,6 C7,9 9,10 10,12 C12,9 12,6 10,1 Z" />
              </Viewbox>
              <TextBlock Text="{Binding DayStreak}" Style="{StaticResource StatValue}" />
              <TextBlock Text="day streak" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel HorizontalAlignment="Center">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,2,0,8">
                <Grid Width="20" Height="20">
                  <Path Stroke="{DynamicResource AccentBlueBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,17 L8,3 L12,17 M5.4,12 L10.6,12" />
                  <Path Stroke="{DynamicResource AccentBlueBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M15,4 L15,16 M13,4 L17,4 M13,16 L17,16" />
                </Grid>
              </Viewbox>
              <TextBlock Text="{Binding WordsDictatedDisplay}" Style="{StaticResource StatValue}" />
              <TextBlock Text="words dictated" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel HorizontalAlignment="Center">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,2,0,8">
                <Grid Width="20" Height="20">
                  <Path Stroke="{DynamicResource SuccessGreenBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,13 A7,7 0 0 1 17,13" />
                  <Path Stroke="{DynamicResource SuccessGreenBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10,13 L14,8" />
                  <Ellipse Width="2.8" Height="2.8" Fill="{DynamicResource SuccessGreenBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8.6,11.6,0,0" />
                </Grid>
              </Viewbox>
              <TextBlock Text="{Binding AverageWpm}" Style="{StaticResource StatValue}" />
              <TextBlock Text="avg WPM" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel HorizontalAlignment="Center">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,2,0,8">
                <Grid Width="20" Height="20">
                  <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,4,0,0" />
                  <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,5,0,0" />
                  <Path Fill="{DynamicResource AccentBlueBrush}" Data="M3,17 C3.3,13.8 5.5,12 8,12 C10.5,12 12.7,13.8 13,17 Z" />
                  <Path Fill="{DynamicResource AccentBlueBrush}" Opacity="0.75" Data="M11,17 C11.2,14.3 13,12.8 15,12.8 C16.8,12.8 18.5,14.3 18.8,17 Z" />
                </Grid>
              </Viewbox>
              <TextBlock Text="{Binding MeetingCount}" Style="{StaticResource StatValue}" />
              <TextBlock Text="meetings" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,14" Visibility="{Binding SetupNeedsResume, Converter={StaticResource BooleanToVisibilityConverter}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Resume setup" Click="ResumeSetup_Click" AutomationProperties.Name="Resume deferred Muesli setup" />
            <StackPanel Margin="0,0,16,0"><TextBlock Text="Finish setting up Muesli" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding SetupResumeLabel}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="12,0,12,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Text="{Binding PreviewPageStateMessage}" MaxWidth="360"
                         Visibility="Visible"
                         TextTrimming="CharacterEllipsis"
                         FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
              <Button Margin="16,-6,0,0" Style="{StaticResource GhostButton}" Click="OpenButtonContextMenu_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                  <TextBlock Text="{Binding DictationFilterLabel}" Margin="6,0,0,0" />
                  <TextBlock Text="⌄" Margin="6,-1,0,0" />
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="All time" Tag="all" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last 2 days" Tag="last2Days" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last week" Tag="lastWeek" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last 2 weeks" Tag="last2Weeks" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last month" Tag="lastMonth" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last 3 months" Tag="last3Months" Click="SetDictationFilter_Click" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding DictationHeaderLabel}" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
          </DockPanel>

          <Border Grid.Row="1"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="10">
            <Grid>
              <ListBox ItemsSource="{Binding FilteredDictations}"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource MuesliListBoxItem}"
                       MouseDoubleClick="DictationsList_MouseDoubleClick"
                       Visibility="{Binding HasDictations, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   Margin="20,18,20,2"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="20,16"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="DictationRow_Click">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Background="Transparent"
                               BorderThickness="0"
                               IsReadOnly="True"
                               Cursor="IBeam"
                               Padding="0"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Disabled"
                               SelectionBrush="{DynamicResource AccentBlueBrush}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,-4,0,0">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Copy" Click="CopyDictation_Click" />
                        <Button Margin="6,0,0,0" Style="{StaticResource GhostButton}" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource ErrorRedTransparentBrush}" ToolTip="Delete" Click="DeleteDictation_Click" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasDictations, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="&#xE70F;" Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Text="No dictations yet" Style="{StaticResource EmptyStateTitle}" />
                <TextBlock Text="Hold your shortcut to dictate. Transcripts will appear here." Style="{StaticResource EmptyStateBody}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="SearchPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
          <TextBlock Text="{Binding SearchResultsTitle}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding SearchResultsSummary}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <Border Margin="0,14,0,0"
                  Padding="10,0"
                  Height="36"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="6">
            <TextBox x:Name="MainSearchInput"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource AccentBlueBrush}"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     ToolTip="Search dictations and meetings"
                     AutomationProperties.Name="Search dictations and meetings" />
          </Border>
        </StackPanel>

         <Grid Grid.Row="1">
           <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="0,0,12,0"
                         Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
             <StackPanel MaxWidth="980" Margin="0,0,0,24">
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="DICTATIONS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="{DynamicResource BackgroundRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,0,24">
              <ListBox ItemsSource="{Binding SearchDictationResults}"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource MuesliListBoxItem}"
                       MouseDoubleClick="DictationsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="20,14"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="DictationRow_Click">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Background="Transparent"
                               BorderThickness="0"
                               IsReadOnly="True"
                               Cursor="IBeam"
                               Padding="0"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Disabled"
                               SelectionBrush="{DynamicResource AccentBlueBrush}" />
                      <Button Grid.Column="2"
                              Margin="14,-4,0,0"
                              Style="{StaticResource GhostButton}"
                              Content="&#xE8C8;"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              ToolTip="Copy"
                              Click="CopyDictation_Click" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="MEETINGS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding SearchMeetingResults}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ItemContainerStyle="{StaticResource MuesliListBoxItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource BackgroundRaisedBrush}"
                          BorderBrush="{DynamicResource BorderBrushSoft}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="16"
                          Margin="0,0,0,10"
                          Cursor="Hand"
                          MouseLeftButtonUp="MeetingCard_Click">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Metadata}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PreviewText}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   MaxHeight="38"
                                   LineHeight="19" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="&#xE8B7;"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 FontSize="14"
                                 Foreground="{DynamicResource AccentBlueBrush}"
                                 Margin="0,2,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
             </ListBox>
           </StackPanel>
         </ScrollViewer>
         <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasSearchResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
           <TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIcon}" />
           <TextBlock Text="No results found" Style="{StaticResource EmptyStateTitle}" />
           <TextBlock Text="Try a different search term." Style="{StaticResource EmptyStateBody}" />
          </StackPanel>
        </Grid>
      </Grid>

       <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
          <StackPanel MaxWidth="860" Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />

            <TabControl Style="{StaticResource MuesliTabControl}">
              <TabItem Header="General" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Your name" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource MuesliTextBox}"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Launch at login" IsChecked="{Binding StartAtLogin}" />
                      <TextBlock Text="{Binding StartupRegistrationLabel}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Repair startup registration" Click="RepairStartup_Click" Margin="0,8,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Repair Windows startup registration" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Resume setup" Click="ResumeSetup_Click" AutomationProperties.Name="Resume setup"/><TextBlock Text="{Binding SetupResumeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /></DockPanel>
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Open dashboard on launch" IsChecked="{Binding OpenDashboardOnLaunch}" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="MICROPHONE" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                      </Grid.ColumnDefinitions>
                      <ComboBox Style="{StaticResource MuesliComboBox}"
                                ItemsSource="{Binding MicrophoneDevices}"
                                SelectedItem="{Binding SelectedMicrophone}" />
                      <Button Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource PrimaryButton}" Click="TestMic_Click" Content="Test mic" />
                    </Grid>
                  </Border>
                </StackPanel>
              </TabItem>

              <TabItem Header="Dictation" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="TRANSCRIPTION" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Transcription" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="{Binding SelectedModelDescription}" Margin="0,4,18,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding SelectedModelLanguages}" Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DictationModelRuntimeStatus, Mode=OneWay}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource MuesliComboBox}"
                                  ItemsSource="{Binding TranscriptionModels}"
                                  SelectedItem="{Binding SelectedTranscriptionModel, Mode=TwoWay}"
                                  DisplayMemberPath="PickerLabel" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Remove filler words" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Remove common hesitations such as um, uh, and you know before dictionary correction." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" Content="Enable" IsChecked="{Binding RemoveFillerWords}" HorizontalAlignment="Right" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Local cleanup" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Optional native Qwen/GGUF cleanup for meetings and imports. Dictation skips cleanup to keep paste latency under a second." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding QwenCleanupRuntimeStatus, Mode=OneWay}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" Content="Enable" IsChecked="{Binding EnableLocalCleanup}" HorizontalAlignment="Right" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Hands-Free Mode" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Double-tap the shortcut to start, tap again to stop." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" IsChecked="{Binding EnableDoubleTapDictation}" HorizontalAlignment="Right" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="CONTROLS" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Push to Talk" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding SelectedHotkey}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Paste behavior" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding PasteBehaviors}" SelectedItem="{Binding SelectedPasteBehavior}" />
                      </Grid>
                      <Button Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" PreviewMouseDown="HoldToDictate_MouseDown" PreviewMouseUp="HoldToDictate_MouseUp" Content="Hold to dictate" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>

              <TabItem Header="Meetings" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="RECORDING" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Final meeting and import model" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Used after recorded meetings and for imported audio/video. Selection never starts a download." Margin="0,4,18,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding FinalMeetingModelStatus}" Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}"
                                  ItemsSource="{Binding TranscriptionModels}"
                                  SelectedItem="{Binding SelectedFinalMeetingModel, Mode=TwoWay}"
                                  DisplayMemberPath="PickerLabel" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Live meeting model" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="{Binding LiveMeetingModelStatus}" Margin="0,4,18,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding LiveMeetingModels}" SelectedItem="{Binding SelectedLiveMeetingModel, Mode=TwoWay}" DisplayMemberPath="Label" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Transcript ownership" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Preview-only saves the final model's transcript. Unified saves live output and uses the final model only for measured gaps." Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding LiveTranscriptOwnershipModes}" SelectedItem="{Binding SelectedLiveTranscriptOwnership, Mode=TwoWay}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <StackPanel>
                        <TextBlock Text="{Binding LivePreviewOwnerLabel, StringFormat=Live preview owner: {0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding FinalTranscriptOwnerLabel, StringFormat=Final transcript owner: {0}}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding GapRecoveryOwnerLabel, StringFormat=Gap recovery: {0}}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                      <CheckBox Margin="0,12,0,0" Style="{StaticResource MuesliCheckBox}" Content="Show microphone/system waveform levels when hovering the live transcript" IsChecked="{Binding ShowLiveWaveformOnHover}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Notify when meeting detected" IsChecked="{Binding AutoMeetingDetectionEnabled}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Save meeting recording" IsChecked="{Binding SaveMeetingRecordings}" />
                      <TextBlock Text="Windows checks active app titles, supported browser URLs where accessible, and meeting app process names." Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Check meeting detection now" Click="CheckMeetingDetection_Click" />
                      <TextBlock Text="{Binding MeetingDetectionStatus}" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="MEETING SUMMARIES" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Summary backend" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="{Binding SummaryProviderDisclosureText}" Margin="0,5,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding SummaryProviders}" SelectedItem="{Binding SelectedSummaryProvider}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Ollama server" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Used only when the summary backend is Ollama. A localhost address keeps the transcript on this machine." Margin="0,5,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OllamaEndpoint, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Ollama model" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Model tag as installed in Ollama, for example llama3.1:8b." Margin="0,5,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OllamaModel, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default template" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding SummaryTemplates}" SelectedItem="{Binding SelectedSummaryTemplate}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenAI API key" Style="{StaticResource SettingsRowLabel}" />
                        <StackPanel Grid.Column="1">
                          <PasswordBox x:Name="OpenAIApiKeyBox" Height="34" Padding="9,6" Background="{DynamicResource BackgroundRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushMedium}" BorderThickness="1" PasswordChanged="OpenAIApiKeyBox_PasswordChanged" />
                          <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding OpenAIApiKeyStatus}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Click="ClearOpenAIApiKey_Click" Padding="5,1" />
                          </DockPanel>
                        </StackPanel>
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenAI model" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OpenAIModel, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenRouter API key" Style="{StaticResource SettingsRowLabel}" />
                        <StackPanel Grid.Column="1">
                          <PasswordBox x:Name="OpenRouterApiKeyBox" Height="34" Padding="9,6" Background="{DynamicResource BackgroundRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushMedium}" BorderThickness="1" PasswordChanged="OpenRouterApiKeyBox_PasswordChanged" />
                          <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding OpenRouterApiKeyStatus}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Click="ClearOpenRouterApiKey_Click" Padding="5,1" />
                          </DockPanel>
                        </StackPanel>
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenRouter model" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="POST-MEETING AUTOMATION" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <CheckBox Style="{StaticResource MuesliCheckBox}"
                                Content="Run an executable after a newly completed meeting is saved"
                                IsChecked="{Binding PostMeetingHookEnabled}" />
                      <TextBlock Text="Disabled by default. Runs only after durable recording completion or successful recovery; opening or re-summarizing a meeting never runs it. The executable receives one versioned JSON document over standard input and no meeting-derived command-line arguments."
                                 Margin="0,7,0,12" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource MuesliTextBox}"
                                 Text="{Binding PostMeetingHookExecutablePath, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                Content="Choose .exe…" Click="BrowseHookExecutable_Click" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Transcript exposure" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Metadata only sends neither transcript data nor a path. Inline is an explicit disclosure. Auto-export path is populated only when the Markdown export succeeds."
                                     Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}"
                                  ItemsSource="{Binding HookTranscriptPolicies}" SelectedItem="{Binding SelectedHookTranscriptPolicy}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Limits and retry" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Each attempt is terminated after the timeout. Output is bounded and redacted in diagnostics."
                                     Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Timeout (sec)" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                          <TextBox Style="{StaticResource MuesliTextBox}" Text="{Binding PostMeetingHookTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="Attempts" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                          <TextBox Style="{StaticResource MuesliTextBox}" Text="{Binding PostMeetingHookMaxAttempts, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                      </Grid>
                      <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                              Content="Test hook safely" Click="TestPostMeetingHook_Click" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="AUTOMATIC MARKDOWN EXPORT" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <CheckBox Style="{StaticResource MuesliCheckBox}"
                                Content="Export Markdown after a newly completed meeting is saved"
                                IsChecked="{Binding AutoExportMarkdownEnabled}" />
                      <TextBlock Text="The selected destination remains user-owned. Muesli creates collision-safe files there and never deletes or overwrites existing files."
                                 Margin="0,7,0,12" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource MuesliTextBox}"
                                 Text="{Binding AutoExportMarkdownDirectory, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                Content="Choose folder…" Click="BrowseAutoExportDirectory_Click" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Content" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}"
                                  ItemsSource="{Binding AutoExportContentOptions}" SelectedItem="{Binding SelectedAutoExportContent}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="{Binding PostMeetingAutomationStatusText}" Margin="0,2,0,8"
                             FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </TabItem>

              <TabItem Header="Computer Use" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="HIGH-RISK OPTIONAL SUBSYSTEM" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <CheckBox Style="{StaticResource MuesliCheckBox}"
                                Content="Enable voice-driven Computer Use"
                                IsChecked="{Binding ComputerUseEnabled}" />
                      <TextBlock Margin="0,7,0,12" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                                 Text="Disabled by default. Only the Speak planner command button can enter planner mode. Ordinary dictation, dictated phrases, meeting text, and saved transcripts never activate it." />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Planner provider" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Provider and model are independent from meeting summaries and must be selected explicitly. There is no fallback provider."
                                     Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <ComboBox Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding ComputerUsePlannerProviders}" SelectedItem="{Binding SelectedComputerUsePlannerProvider}" />
                          <TextBox Margin="0,8,0,0" Style="{StaticResource MuesliTextBox}" Text="{Binding ComputerUsePlannerModel, UpdateSourceTrigger=LostFocus}" ToolTip="Exact planner model ID" />
                        </StackPanel>
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="14"/><ColumnDefinition Width="95"/><ColumnDefinition Width="14"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Execution limits" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Planner and actions are independently bounded. Stop cancels the active voice capture, provider request, confirmation, or executor action."
                                     Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Planner sec" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/><TextBox Style="{StaticResource MuesliTextBox}" Text="{Binding ComputerUsePlannerTimeoutSeconds, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="Action sec" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/><TextBox Style="{StaticResource MuesliTextBox}" Text="{Binding ComputerUsePerActionTimeoutSeconds, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                        <StackPanel Grid.Column="5"><TextBlock Text="Max actions" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/><TextBox Style="{StaticResource MuesliTextBox}" Text="{Binding ComputerUseMaximumActionCount, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="ALLOWLISTS AND OBSERVATION" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <TextBlock Text="Allowed applications" Style="{StaticResource SettingsRowLabel}" />
                      <TextBlock Text="Semicolon-separated process names, for example notepad; explorer. Only the single approved foreground window is observed; unrelated windows, clipboard history, Credential Manager, and password fields are excluded."
                                 Margin="0,4,0,7" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <TextBox Style="{StaticResource MuesliTextBox}" Text="{Binding ComputerUseAllowedApplications, UpdateSourceTrigger=LostFocus}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Include UI control text (unavailable until masking qualification passes)" IsChecked="{Binding ComputerUseIncludeWindowText}" IsEnabled="False" />
                      <CheckBox Margin="0,8,0,0" Style="{StaticResource MuesliCheckBox}" Content="Include browser page text (unavailable until masking qualification passes)" IsChecked="{Binding ComputerUseIncludeBrowserPageText}" IsEnabled="False" />
                      <CheckBox Margin="0,8,0,0" Style="{StaticResource MuesliCheckBox}" Content="Include scoped screenshots (unavailable until masking qualification passes)" IsChecked="{Binding ComputerUseIncludeScreenshots}" IsEnabled="False" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="SUPPORTED BROWSER INTERFACE" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Browser automation" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Browser actions are available only through an explicitly registered loopback DevTools session. Address-bar UI Automation and arbitrary remote endpoints are not used."
                                     Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding ComputerUseBrowserInterfaces}" SelectedItem="{Binding SelectedComputerUseBrowserInterface}" />
                      </Grid>
                      <TextBox Margin="0,10,0,0" Style="{StaticResource MuesliTextBox}" Text="{Binding ComputerUseBrowserEndpoint, UpdateSourceTrigger=LostFocus}" ToolTip="Loopback DevTools endpoint" />
                      <TextBlock Text="Allowed domains" Style="{StaticResource SettingsRowLabel}" Margin="0,12,0,0" />
                      <TextBox Margin="0,7,0,0" Style="{StaticResource MuesliTextBox}" Text="{Binding ComputerUseAllowedBrowserDomains, UpdateSourceTrigger=LostFocus}" ToolTip="Exact hostnames separated by semicolons" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="EXPLICIT VOICE SESSION" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <TextBlock Text="Each session plans from a fresh approved foreground observation. Unsupported or malformed actions, stale state, elevated targets, and policy downgrades fail closed. Risky actions always require a fresh confirmation."
                                 FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ComputerUseVoiceButtonText}" Click="ComputerUseVoice_Click" />
                        <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="Stop" IsEnabled="{Binding ComputerUseStopEnabled}" Click="StopComputerUse_Click" />
                        <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open trace diagnostics" Click="OpenComputerUseDiagnostics_Click" />
                      </StackPanel>
                      <TextBlock Text="{Binding ComputerUseStatusText}" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>

              <TabItem Header="Appearance" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Theme" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Switch between the OG light and dark palettes." Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Show floating indicator" IsChecked="{Binding ShowFloatingIndicator}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Floating indicator position" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Dragging the indicator saves a custom position until this anchor is changed." Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding IndicatorPositions}" SelectedItem="{Binding SelectedIndicatorPosition}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>
            </TabControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="ModelsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="960" Margin="0,0,0,24">
          <TextBlock Text="Models" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Assign separate offline models to dictation and final meeting/import transcription. Selecting a role never downloads or activates a recognizer." Style="{StaticResource PageSubtitle}" />
          <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/nvidia.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Transcription roles" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="5" Background="{DynamicResource AccentBadgeBackgroundBrush}">
                    <TextBlock Text="{Binding ActiveModelLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding SelectedModelDescription}" Margin="0,8,0,4" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedModelLanguages}" Margin="0,0,0,12" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="360" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Dictation model" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <ComboBox Grid.Column="1"
                            Style="{StaticResource MuesliComboBox}"
                            ItemsSource="{Binding TranscriptionModels}"
                            SelectedItem="{Binding SelectedTranscriptionModel, Mode=TwoWay}"
                            DisplayMemberPath="PickerLabel" />
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="360" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Final meeting" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <ComboBox Grid.Column="1"
                            Style="{StaticResource MuesliComboBox}"
                            ItemsSource="{Binding TranscriptionModels}"
                            SelectedItem="{Binding SelectedFinalMeetingModel, Mode=TwoWay}"
                            DisplayMemberPath="PickerLabel" />
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="360" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Live meeting" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding LiveMeetingModels}" SelectedItem="{Binding SelectedLiveMeetingModel, Mode=TwoWay}" DisplayMemberPath="Label" />
                </Grid>
                <TextBlock Text="{Binding LivePreviewOwnerLabel, StringFormat=Live preview owner: {0}}" Margin="120,0,0,4" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding FinalTranscriptOwnerLabel, StringFormat=Final transcript owner: {0}}" Margin="120,0,0,4" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding GapRecoveryOwnerLabel, StringFormat=Gap recovery: {0}}" Margin="120,0,0,12" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="Status" Width="72" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Text="{Binding DictationModelRuntimeStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="Prepare all models" Click="DownloadAllModels_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="OpenTranscriptionModelCache_Click" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding DictationModelStatusLabel}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <TextBlock Text="OFFLINE TRANSCRIPTION MODELS" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding TranscriptionModelItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Summary}" Margin="0,5,20,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Languages}" Margin="0,4,20,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DiskSize, StringFormat=Installed: {0}}" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding DownloadSize, StringFormat=Catalog: {0}}" Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Style="{StaticResource PrimaryButton}" Content="Prepare" Click="PrepareModelItem_Click" IsEnabled="{Binding CanPrepare}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="CancelModelItem_Click" IsEnabled="{Binding CanCancel}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Retry" Click="RetryModelItem_Click" IsEnabled="{Binding CanRetry}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Verify" Click="VerifyModelItem_Click" IsEnabled="{Binding CanVerify}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Diagnostics" Click="ModelDiagnosticsItem_Click" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Delete" Foreground="{DynamicResource ErrorRedBrush}" Click="DeleteModelItem_Click" IsEnabled="{Binding CanDelete}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="LIVE TRANSCRIPTION MODELS" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="Preparing a live model never selects or enables it. Live transcription remains off until you explicitly choose it above." Margin="0,0,0,10" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding StreamingModelItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Summary}" Margin="0,5,20,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Languages}" Margin="0,4,20,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DiskSize, StringFormat=Installed: {0}}" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding DownloadSize, StringFormat=Catalog: {0}}" Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Style="{StaticResource PrimaryButton}" Content="Prepare" Click="PrepareStreamingModelItem_Click" IsEnabled="{Binding CanPrepare}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="CancelStreamingModelItem_Click" IsEnabled="{Binding CanCancel}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Retry" Click="RetryStreamingModelItem_Click" IsEnabled="{Binding CanRetry}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Verify" Click="VerifyStreamingModelItem_Click" IsEnabled="{Binding CanVerify}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Diagnostics" Click="StreamingModelDiagnosticsItem_Click" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Delete" Foreground="{DynamicResource ErrorRedBrush}" Click="DeleteStreamingModelItem_Click" IsEnabled="{Binding CanDelete}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/qwen.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Cleanup" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}">
                    <TextBlock Text="Qwen · optional" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="Optional native local cleanup for punctuation, casing, filler words, and repeated ASR fragments. If unavailable, Muesli keeps the original transcript." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="Status" Width="72" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Text="{Binding QwenCleanupRuntimeStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource GhostButton}" Content="Open cache" Click="OpenCleanupModelCache_Click" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding QwenCleanupStatusLabel}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/openai.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Speaker labels" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Optional native ONNX speaker labeling for recorded meetings. Dictation does not require it." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Status" Width="90" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Text="{Binding DiarizationDependencyStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource GhostButton}" Content="Check setup" Click="RefreshRuntimeDiagnostics_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="OpenDiarizationModelCache_Click" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding SpeakerDiarizationStatusLabel, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Cache and benchmark" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Manage local native model files and measure cached ASR models on recent captured audio." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,0,0,12">
                  <Button Style="{StaticResource SecondaryButton}" Content="Run benchmark" Click="RunBenchmark_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="OpenModelCache_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open logs" Click="OpenLogs_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Refresh" Click="RefreshRuntimeDiagnostics_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Clear cache" Foreground="{DynamicResource ErrorRedBrush}" Click="ClearModelCache_Click" />
                </WrapPanel>
                <TextBlock Text="{Binding BenchmarkSummary, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Detailed setup and benchmark information is written to logs." Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding ModelCacheSize}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="MeetingsPage" Visibility="Collapsed">
        <Grid x:Name="MeetingsBrowserView">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

           <Grid Grid.Row="1" Margin="0,0,0,22">
             <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
             </Grid.ColumnDefinitions>
             <StackPanel>
               <TextBlock Text="{Binding CurrentMeetingFolderName}" Style="{StaticResource PageTitle}" />
               <StackPanel Orientation="Horizontal">
                 <TextBlock Text="{Binding VisibleMeetingCount}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                 <TextBlock Text=" meetings" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
               </StackPanel>
               <TextBlock Text="{Binding MeetingSessionStatus}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
               <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
             </StackPanel>
             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
               <Button Style="{StaticResource GhostButton}" Click="ToggleMeetingSort_Click">
                 <StackPanel Orientation="Horizontal">
                   <TextBlock Text="↕" Margin="0,0,6,0" />
                   <TextBlock Text="{Binding MeetingSortLabel}" />
                 </StackPanel>
               </Button>
               <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" ToolTip="{Binding MeetingFilterLabel}" Click="OpenButtonContextMenu_Click">
                 <StackPanel Orientation="Horizontal">
                   <TextBlock Text="☰" />
                   <TextBlock Text="{Binding MeetingFilterLabel}" Margin="6,0,0,0" />
                   <TextBlock Text="⌄" Margin="6,-1,0,0" />
                 </StackPanel>
                 <Button.ContextMenu>
                   <ContextMenu>
                     <MenuItem Header="All time" Tag="all" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 2 days" Tag="last2Days" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last week" Tag="lastWeek" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 2 weeks" Tag="last2Weeks" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last month" Tag="lastMonth" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 3 months" Tag="last3Months" Click="SetMeetingFilter_Click" />
                   </ContextMenu>
                 </Button.ContextMenu>
               </Button>
               <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="ManageTemplates_Click" Content="Manage Templates" />
               <Button Margin="8,0,0,0"
                       Style="{StaticResource SecondaryButton}"
                       Visibility="{Binding HasRecoverableMeetings, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Click="RecoverInterruptedMeetings_Click"
                       Content="{Binding RecoverInterruptedButtonText}" />
               <!-- Chosen before recording; this is the template finalization will use for the notes. -->
               <ComboBox Margin="8,0,0,0" Width="190"
                         Style="{StaticResource MuesliComboBox}"
                         ItemsSource="{Binding SummaryTemplates}"
                         SelectedItem="{Binding SelectedSummaryTemplate, Mode=TwoWay}"
                         ToolTip="Notes template used when this recording is finalized" />
               <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="ToggleMeetingRecording_Click" Content="{Binding MeetingRecordingButtonText}" />
               <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                       IsEnabled="{Binding IsNotImportingMeeting}"
                       Click="ImportMeeting_Click" Content="Import media" />
               <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsImportingMeeting, Converter={StaticResource BooleanToVisibilityConverter}}">
                 <ProgressBar Width="110" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                              Minimum="0" Maximum="100"
                              Value="{Binding ImportProgressPercent, Mode=OneWay}"
                              IsIndeterminate="{Binding ImportProgressIsIndeterminate}" />
                 <TextBlock Text="{Binding ImportProgressLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                            FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                 <Button Style="{StaticResource SecondaryButton}" Click="CancelImport_Click" Content="Cancel" />
               </StackPanel>
             </StackPanel>
           </Grid>
           <Grid Grid.Row="2">
             <ListBox ItemsSource="{Binding FilteredMeetings}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      ItemContainerStyle="{StaticResource MuesliListBoxItem}"
                      Visibility="{Binding HasMeetings, Converter={StaticResource BooleanToVisibilityConverter}}">
               <ListBox.ItemTemplate>
                 <DataTemplate>
                   <Border Background="{DynamicResource BackgroundRaisedBrush}"
                           BorderBrush="{DynamicResource BorderBrushSoft}"
                           BorderThickness="1"
                           CornerRadius="10"
                           Padding="16"
                           Margin="0,0,0,10"
                           Cursor="Hand"
                           MouseLeftButtonUp="MeetingCard_Click">
                     <Grid>
                       <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="Auto" />
                       </Grid.ColumnDefinitions>
                       <StackPanel>
                         <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                         <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                           <TextBlock Text="{Binding Metadata}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                         </StackPanel>
                         <TextBlock Text="{Binding PreviewText}"
                                    Margin="0,8,0,0"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="13"
                                    MaxHeight="38"
                                    LineHeight="19" />
                       </StackPanel>
                       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                         <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,2,0,0" />
                         <Button Margin="6,-2,0,0" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource ErrorRedTransparentBrush}" ToolTip="Delete" Click="DeleteMeeting_Click">
                           <Button.Style>
                             <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                               <Setter Property="Opacity" Value="0" />
                               <Style.Triggers>
                                 <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                   <Setter Property="Opacity" Value="1" />
                                 </DataTrigger>
                               </Style.Triggers>
                             </Style>
                           </Button.Style>
                         </Button>
                       </StackPanel>
                     </Grid>
                   </Border>
                 </DataTemplate>
               </ListBox.ItemTemplate>
             </ListBox>
             <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasMeetings, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
               <TextBlock Text="&#xE720;" Style="{StaticResource EmptyStateIcon}" />
               <TextBlock Text="No meetings yet" Style="{StaticResource EmptyStateTitle}" />
               <TextBlock Text="Click Record or Import to capture your first meeting." Style="{StaticResource EmptyStateBody}" />
             </StackPanel>
           </Grid>
        </Grid>

        <Grid x:Name="MeetingDetailView" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" MaxWidth="980" Margin="40,0,40,0">
            <Button Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left"
                    Click="BackToMeetings_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="‹" Margin="0,0,6,0" />
                <TextBlock Text="Back to Meetings" />
              </StackPanel>
            </Button>

            <Grid Margin="0,18,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBox Text="{Binding SelectedMeetingTitle, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource MuesliTextBox}"
                         FontSize="26" FontWeight="Bold" Padding="6,2"
                         Background="Transparent" BorderThickness="0"
                         ToolTip="Click to rename this meeting" />
                <TextBlock Text="{Binding SelectedMeetingTitleOwnership}" Margin="6,2,0,6" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding SelectedMeetingMetadata}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Margin="10,-2,0,0" Padding="8,4" CornerRadius="12" Background="{DynamicResource AccentBadgeBackgroundBrush}">
                    <TextBlock Text="Auto Notes" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                  </Border>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="220" Height="32" Background="{DynamicResource BackgroundRaisedBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MeetingNotesTab"
                            Margin="2"
                            Background="{DynamicResource SurfaceSelectedBrush}"
                            CornerRadius="6"
                            Cursor="Hand"
                            MouseLeftButtonUp="ShowMeetingNotesTab_Click">
                      <TextBlock x:Name="MeetingNotesTabLabel" Text="Notes" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Border x:Name="MeetingTranscriptTab"
                            Grid.Column="1"
                            Margin="2"
                            Background="Transparent"
                            CornerRadius="6"
                            Cursor="Hand"
                            MouseLeftButtonUp="ShowMeetingTranscriptTab_Click">
                      <TextBlock x:Name="MeetingTranscriptTabLabel" Text="Transcript" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                  </Grid>
                </Border>
                <Button Style="{StaticResource GhostButton}" Click="MoreMeetingActions_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,4,0" />
                    <TextBlock Text="More" />
                  </StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Export Notes" Click="ExportMeetingNotes_Click" />
                      <MenuItem Header="Export Transcript" Click="ExportMeetingTranscript_Click" />
                      <MenuItem Header="Export Full Meeting" Click="ExportFullMeeting_Click" />
                      <Separator />
                      <MenuItem Header="Automation Diagnostics" Click="ShowMeetingAutomationDiagnostics_Click" />
                      <MenuItem Header="Play Recording" Click="OpenSelectedMeetingAudio_Click" />
                      <MenuItem Header="Move to Folder" Click="MoveSelectedMeeting_Click" />
                      <Separator />
                      <MenuItem Header="Delete Meeting" Foreground="{DynamicResource ErrorRedBrush}" Click="DeleteSelectedMeeting_Click" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>

          <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="-24,0,-24,0" />

          <ScrollViewer Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,12,0">
            <StackPanel MaxWidth="980" Margin="0,0,0,24">
              <Border Visibility="{Binding HasMeetingPlayback, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Background="{DynamicResource BackgroundRaisedBrush}"
                      BorderBrush="{DynamicResource BorderBrushSoft}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="14"
                      Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0"
                            Style="{StaticResource MuesliComboBox}"
                            ItemsSource="{Binding MeetingPlaybackTracks}"
                            SelectedItem="{Binding SelectedMeetingPlaybackTrack, Mode=TwoWay}"
                            DisplayMemberPath="Label" />
                  <Button Grid.Column="1"
                          Margin="10,0,10,0"
                          Style="{StaticResource SecondaryButton}"
                          Click="ToggleMeetingPlayback_Click"
                          Content="{Binding MeetingPlaybackButtonText}" />
                  <Slider Grid.Column="2"
                          VerticalAlignment="Center"
                          Minimum="0"
                          Maximum="{Binding MeetingPlaybackDuration}"
                          Value="{Binding MeetingPlaybackPosition, Mode=TwoWay}"
                          ValueChanged="MeetingPlaybackSeek_ValueChanged" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding MeetingPlaybackTimeLabel}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="11"
                             FontFamily="Consolas"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </Border>
              <StackPanel x:Name="MeetingWarningsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <Border Background="#FFFDF0D5" BorderBrush="#FFF4D03F" BorderThickness="1" CornerRadius="8" Padding="12,10">
                  <StackPanel>
                    <TextBlock Text="Recording warnings" FontSize="12" FontWeight="SemiBold" Foreground="#FFB45309" Margin="0,0,0,6" />
                    <ItemsControl x:Name="MeetingWarningsItems">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#FFB45309" Margin="0,2,6,0" />
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#FFB45309" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="MeetingNotesPanel">
                <DockPanel Margin="0,14,0,12">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox Width="210"
                              Margin="0,0,10,0"
                              Style="{StaticResource MuesliComboBox}"
                              ItemsSource="{Binding SummaryTemplates}"
                              SelectedItem="{Binding SelectedMeetingTemplate}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                Visibility="{Binding IsSummarizing, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <ProgressBar Width="90" Height="6" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Text="Generating…" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Button Style="{StaticResource SecondaryButton}" Click="CancelSummary_Click" Content="Cancel" />
                    </StackPanel>
                    <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding CanRetrySummary, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="RetrySummary_Click" Content="Retry" />
                    <Button Margin="0,0,10,0" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsNotSummarizing}"
                            Click="GenerateSelectedMeetingNotes_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedMeetingNotesActionLabel}" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="CopySelectedMeetingNotes_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="Copy Notes" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <TextBlock Text="NOTES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                </DockPanel>

                <Border Background="{DynamicResource BackgroundRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24"
                        Margin="0,0,0,24">
                  <StackPanel x:Name="MeetingNotesContent" />
                </Border>

                <Border Background="{DynamicResource BackgroundRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24"
                        Margin="0,0,0,24">
                  <StackPanel>
                    <TextBlock Text="My notes" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Your own notes. Kept exactly as written when notes are regenerated."
                               Margin="0,4,0,10" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding SelectedMeetingManualNotes, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource MuesliTextBox}"
                             MinHeight="110"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="MeetingTranscriptPanel" Visibility="Collapsed">
                <DockPanel Margin="0,14,0,12">
                  <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="CopySelectedMeetingTranscript_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                      <TextBlock Text="Copy Transcript" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="TRANSCRIPT" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel x:Name="SpeakerAliasPanel" Margin="0,0,0,12" />

                <Border Background="{DynamicResource BackgroundRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24">
                  <TextBox Text="{Binding SelectedMeetingTranscript, Mode=OneWay}"
                           TextWrapping="Wrap"
                           AcceptsReturn="True"
                           Background="Transparent"
                           BorderThickness="0"
                           IsReadOnly="True"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Cursor="IBeam"
                           FontFamily="Consolas"
                           FontSize="13"
                           MinHeight="420"
                           SelectionBrush="{DynamicResource AccentBlueBrush}" />
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Grid x:Name="DictionaryPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="860" Margin="0,0,0,24">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="AddDictionaryEntry_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="+" FontWeight="Bold" Margin="0,0,6,0" />
                <TextBlock Text="Add new" />
              </StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="Dictionary" Style="{StaticResource PageTitle}" />
              <TextBlock Text="Add custom words for names, brands, and domain terms, and tune how aggressively each entry should fuzzy-match transcription errors." Style="{StaticResource PageSubtitle}" />
              <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Border Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="0">
            <StackPanel>
              <Grid Margin="16,16,16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DictionaryPhraseBox" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" FontSize="14" />
                <TextBox x:Name="DictionaryReplacementBox" Grid.Column="1" Margin="12,0,0,0" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" FontSize="14" />
              </Grid>
              <Grid Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Matching threshold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Slider x:Name="DictionaryThresholdSlider"
                        Grid.Column="1"
                        Minimum="0.85"
                        Maximum="0.98"
                        SmallChange="0.01"
                        LargeChange="0.05"
                        Value="0.90" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ElementName=DictionaryThresholdSlider, Path=Value, StringFormat={}{0:0.00}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" />
              <ListBox ItemsSource="{Binding DictionaryEntries}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" ItemContainerStyle="{StaticResource MuesliListBoxItem}" Visibility="{Binding HasDictionaryEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="16,16">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" />
                        <TextBox Grid.Column="1" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" />
                      </Grid>
                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="48" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Matching threshold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.70" Maximum="0.95" SmallChange="0.01" LargeChange="0.05" Value="{Binding MatchingThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{Binding ThresholdDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Content="Delete" Foreground="{DynamicResource ErrorRedBrush}" Click="DeleteDictionaryEntry_Click" />
                        <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Content="Save" Click="SaveDictionaryEntry_Click" />
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Margin="0,32" Visibility="{Binding HasDictionaryEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="&#xE70F;" Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Text="No custom dictionary entries yet" Style="{StaticResource EmptyStateTitle}" />
                <TextBlock Text="Add a word or phrase above to improve transcription accuracy." Style="{StaticResource EmptyStateBody}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="ShortcutsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="860" Margin="0,0,0,24">
          <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Choose your preferred shortcut for dictation." Style="{StaticResource PageSubtitle}" />
          <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Push to Talk" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding ShortcutModeLabel}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Height="26" Padding="12,0" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                  <TextBlock Text="{Binding SelectedHotkey}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,16" />
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="220" HorizontalAlignment="Left" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding SelectedHotkey}" />
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="{Binding CaptureHotkeyButtonText}" Click="CaptureHotkey_Click" />
              </StackPanel>
              <TextBlock Text="{Binding ShortcutCaptureLabel}" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Hands-Free Mode" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Double-tap the selected shortcut to start listening without holding the key." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" IsChecked="{Binding EnableDoubleTapDictation}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="AboutPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="760" Margin="0,0,0,24">
          <TextBlock Text="About" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <TextBlock Text="Setup and tour" Style="{StaticResource SettingsRowLabel}" />
              <TextBlock Text="Resume deferred setup safely, or revisit the feature tour. Setup progress never contains transcripts or provider secrets." Margin="0,4,0,12" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Resume Setup" Click="ResumeSetup_Click" AutomationProperties.Name="Resume Muesli setup" />
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="Feature Tour" Click="FeatureTour_Click" AutomationProperties.Name="Open feature tour" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="APP INFO" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Version" Style="{StaticResource SettingsRowLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Releases" Style="{StaticResource SettingsRowLabel}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="View Releases" Click="CheckForUpdates_Click" AutomationProperties.Name="Check for Muesli updates" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="SUPPORT" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Support Development" Style="{StaticResource SettingsRowLabel}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Donate" Background="{DynamicResource SuccessGreenBrush}" Foreground="{DynamicResource DonateButtonForegroundBrush}" Click="Donate_Click" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Source Code" Style="{StaticResource SettingsRowLabel}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="View on GitHub" Click="ViewGitHub_Click" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Logs" Style="{StaticResource SettingsRowLabel}" />
                  <TextBlock Text="Attach these when reporting microphone, paste, meeting recording, or model setup issues." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Open Logs" Click="OpenLogs_Click" AutomationProperties.Name="Open Muesli logs" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Audio storage" Style="{StaticResource SettingsRowLabel}" />
                  <TextBlock Text="Inspect and remove legacy or interrupted capture files. Saved meeting recordings, imports, transcripts, settings, and models are excluded." Margin="0,4,18,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Inspect Captures" Click="CleanupCaptures_Click" AutomationProperties.Name="Inspect local capture storage" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Privacy" Style="{StaticResource SettingsRowLabel}" />
                  <TextBlock Text="Review local storage, model downloads, meeting detection, logs, and optional cloud transcript processing." Margin="0,4,18,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Open Privacy" Click="OpenPrivacy_Click" AutomationProperties.Name="Open privacy information" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="ACKNOWLEDGEMENTS" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <TextBlock Text="Native sherpa-onnx transcription" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Local Parakeet, Whisper, SenseVoice, Qwen3-ASR, and Cohere inference through sherpa-onnx and ONNX Runtime." Margin="0,4,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border x:Name="VisualVerificationBanner"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="72,44,24,0"
            Padding="10,6"
            Background="#D1A000"
            CornerRadius="0,0,6,6"
            Panel.ZIndex="30"
            IsHitTestVisible="False">
      <TextBlock x:Name="VisualVerificationBannerText" Foreground="#191919"
                 FontWeight="SemiBold"
                 FontSize="11"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Visual verification isolation banner" />
    </Border>
  </Grid>
</Window>
